# ==============================================================================
# Adaptive Serverless Caching - Environment Configuration Template
# Reference: docs/technical-research-plan.md (Section 10.3 & Section 6.5)
# Note: Keep secrets out of Git. Commit .env.example with placeholder values only.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Server Settings
# ------------------------------------------------------------------------------
APP_ENV=development
HOST=0.0.0.0
PORT=5000

# ------------------------------------------------------------------------------
# PostgreSQL Database (Neon)
# Reference: Section 4.3 & 10
# Note: PostgreSQL is the authoritative source of truth across all configurations (E1-E6).
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@ep-example.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# External Cache (Upstash Redis)
# Reference: Section 2, 5, 6.5, & 10.3
# Note: Required for configurations using L2 Redis (E3, E4, E5, E6).
# Fallback to PostgreSQL on failure is handled gracefully.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://example-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
REDIS_TIMEOUT_SECONDS=2.0

# ------------------------------------------------------------------------------
# Cache Namespace Prefix
# Reference: Section 2 & 10.3
# Note: Isolate cache keys across configurations (e.g., e3, e4, e5, e6).
# Prevents accidental key sharing between experiment runs.
# Key format examples:
#   e3:record:{record_id}
#   e4:l1:record:{record_id} / e4:l2:record:{record_id}
#   e5:l1:record:{record_id} / e5:l2:record:{record_id}
#   e6:l1:record:{record_id} / e6:l2:record:{record_id}
# ------------------------------------------------------------------------------
CACHE_NAMESPACE=e4

# ------------------------------------------------------------------------------
# L1 Process-Local Memory Cache Parameters
# Reference: Section 5 & 6.5
# Note: Used in E2, E4, E5, E6.
# Capacity tested: 100, 1000 entries.
# TTL tested: 5, 30, 60 seconds.
# ------------------------------------------------------------------------------
L1_CAPACITY=1000
L1_TTL_SECONDS=30

# ------------------------------------------------------------------------------
# L2 Shared Redis Cache Parameters
# Reference: Section 5 & 6.5
# Note: Used in E3, E4, E5, E6.
# TTL tested: 30, 60, 300 seconds.
# ------------------------------------------------------------------------------
L2_TTL_SECONDS=60

# ------------------------------------------------------------------------------
# Adaptive Cache Policy Parameters (E5 & E6)
# Reference: Section 5 (E5) & Section 6.5
# Note: Evaluates adaptive admission threshold and bounded adaptive TTL.
# ------------------------------------------------------------------------------
ADMISSION_THRESHOLD=2
ADMISSION_WINDOW_SECONDS=60
ADAPTIVE_TTL_MIN_SECONDS=5
ADAPTIVE_TTL_MAX_SECONDS=300

# ------------------------------------------------------------------------------
# Cross-Instance Invalidation Strategy (E6)
# Reference: Section 5 (E6)
# Candidate mechanisms: version-based validation, pubsub, or short-ttl fallback.
# ------------------------------------------------------------------------------
INVALIDATION_STRATEGY=version
